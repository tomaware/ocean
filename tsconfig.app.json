{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/types/**/*",
    "src/main.tsx",
    "src/app/**/*",
    "src/features/**/*",
    "src/components/**/*",
    "src/services/**/*"
  ]
}
