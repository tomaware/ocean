{
  "name": "ocean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OCEAN — prévisions et sessions pour les sports nautiques du Golfe du Lion",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.app.json",
    "test": "node --test tests/*.test.ts",
    "collect": "node pipeline/collect/run.ts",
    "engines": "node pipeline/engines/run.ts",
    "verify": "node pipeline/verify/run.ts",
    "publish-data": "node pipeline/publish/run.ts",
    "dev": "vite",
    "build": "vite build"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.1",
    "@types/leaflet": "1.9.18",
    "@types/node": "22.15.21",
    "leaflet": "1.9.4",
    "lucide-preact": "0.511.0",
    "preact": "10.26.9",
    "typescript": "5.9.3",
    "uplot": "1.6.32",
    "vite": "6.3.5"
  }
}
